"\"\"",StandardForm],"Print",ExpressionUUID -> "6fe6180d-7281-4eb4-add3-4d5af59a9512"],Cell[
BoxData[
"\"Substituting back: x(t_k) = e^{A\[CenterDot]\[CapitalDelta]t} c(t_k)\"",StandardForm],
"Print",ExpressionUUID -> "b974b42e-4015-4862-bd62-98ea9c5465df"],Cell[
BoxData["\"\"",
StandardForm],"Print",ExpressionUUID -> "fe6fd8fa-cad8-4be3-9381-ff64ba4a0bbf"],Cell[
