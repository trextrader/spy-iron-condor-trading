"\"\"",StandardForm],"Print",ExpressionUUID -> "b4111aa6-da90-41dc-b7ce-c357a9ff40a5"],Cell[
BoxData[
"\"ETD-1 assumes B(s) \[TildeTilde] B_k (constant) over [t_{k-1}, t_k]:\"",StandardForm],
"Print",ExpressionUUID -> "0f68b828-277b-4327-bc6a-02cd053cf924"],Cell[
BoxData["\"\"",
StandardForm],"Print",ExpressionUUID -> "537cb7ec-eeda-4cb0-ab3d-984f2ad2839f"],Cell[
BoxData[
"\"    x_k = e^{A\[CapitalDelta]t} x_{k-1} + (\[Integral]_0^{\[CapitalDelta]t} e^{A\[Tau]} d\[Tau]) B_k\"",
StandardForm],"Print",ExpressionUUID -> "aea45793-b5e2-42dc-991f-3fa192292b43"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "37d538e4-5c25-486f-aa25-e349f69828d1"],Cell[
BoxData[
"\"Computing the integral:\"",StandardForm],"Print",ExpressionUUID -> "8ad67492-0c92-4cc8-83d5-8d3eb2c50dc1"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "735e61b2-0185-475b-be6e-b63cf07fdee2"],Cell[
BoxData[
"\"    \[Integral]_0^{\[CapitalDelta]t} e^{A\[Tau]} d\[Tau] = [A^{-1} e^{A\[Tau]}]_0^{\[CapitalDelta]t}\"",
StandardForm],"Print",ExpressionUUID -> "0755e0ec-a37f-4799-9abd-80c2935e28e8"],Cell[
BoxData[
"\"                       = A^{-1} (e^{A\[CapitalDelta]t} - I)\"",StandardForm],"Print",
ExpressionUUID -> "eff976b9-ec0f-4df2-80cb-76284d63fbf8"],Cell[
BoxData["\"                       = \[CapitalDelta]t \[CenterDot] \[CurlyPhi]_1(A\[CapitalDelta]t)\"",
StandardForm],"Print",ExpressionUUID -> "22165c39-dfcc-45e2-9da3-101b4b1ed349"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "565dc507-ca1a-42a7-8fc0-8bacdb783a1a"],Cell[
BoxData[
"\"where the ETD basis function \[CurlyPhi]_1 is defined as:\"",StandardForm],"Print",
ExpressionUUID -> "d7c5d6a1-0adc-4877-96fb-0e6772696c99"],Cell[
BoxData["\"\"",StandardForm],
"Print",ExpressionUUID -> "db4737d0-9d47-4d7a-b488-d174a7c87bef"],Cell[
BoxData["\"    \[CurlyPhi]_1(M) := M^{-1}(e^M - I)\"",
StandardForm],"Print",ExpressionUUID -> "f9980362-2690-4eb8-b7db-23329b1e098f"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "90324647-4f5e-4c21-886b-a8a6087a02f7"],Cell[
BoxData[
"\"Verification of \[CurlyPhi]_1 integral identity:\"",StandardForm],"Print",ExpressionUUID -> "dc819b57-bf79-4c91-9106-fc004a1ecd80"],Cell[
BoxData[
InterpretationBox[RowBox[{"\"    \[Integral]_0^1 e^{z\[Tau]} d\[Tau] = \"","\[InvisibleSpace]",FractionBox[
RowBox[{RowBox[{"-","1"}],"+",SuperscriptBox["\[ExponentialE]","z"]}],"z"]}],SequenceForm[
"    \[Integral]_0^1 e^{z\[Tau]} d\[Tau] = ",Times[Plus[-1,Power[E,z]],Power[z,-1]]],
Editable -> False],StandardForm],"Print",ExpressionUUID -> "85e3957c-cb08-468e-b8e3-a7024093caef"],Cell[
BoxData[
InterpretationBox[RowBox[{"\"    \[CurlyPhi]_1(z) = (e^z - 1)/z = \"","\[InvisibleSpace]",FractionBox[
RowBox[{RowBox[{"-","1"}],"+",SuperscriptBox["\[ExponentialE]","z"]}],"z"]}],SequenceForm[
"    \[CurlyPhi]_1(z) = (e^z - 1)/z = ",Times[Plus[-1,Power[E,z]],Power[z,-1]]],Editable -> False],
StandardForm],"Print",ExpressionUUID -> "06402ab6-a217-4c15-936f-cdf6785c06d5"],Cell[
BoxData[
InterpretationBox[RowBox[{"\"    Simplify[(e^z-1)/z == \[Integral]_0^1 e^{z\[Tau]} d\[Tau]]: \"","\[InvisibleSpace]","True"}],
SequenceForm["    Simplify[(e^z-1)/z == \[Integral]_0^1 e^{z\[Tau]} d\[Tau]]: ",True],
Editable -> False],StandardForm],"Print",ExpressionUUID -> "4e5504ee-4bb7-415d-a63b-c7beae49a237"],Cell[
