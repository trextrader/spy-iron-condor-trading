"\"\"",StandardForm],"Print",ExpressionUUID -> "94281d0d-3fb7-48df-8133-c13e44372b80"],Cell[
BoxData[
"\"    d/dt[e^{At}] = A\[CenterDot]e^{At}  \[Checkmark] (matrix exponential property)\"",
StandardForm],"Print",ExpressionUUID -> "ec4b195a-665e-45d6-9ccc-957440c4798e"],Cell[
BoxData[
"\"\\n\:250c\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\:2510\"",
StandardForm],"Print",ExpressionUUID -> "7c757e3d-3ef8-4d90-9702-6a4285ea926b"],Cell[
BoxData[
"\"\[VerticalLine] STEP 2: Variation of Constants Ansatz                       \[VerticalLine]\"",
StandardForm],"Print",ExpressionUUID -> "d901b7a2-ae54-490e-9ece-c84c5b14b10a"],Cell[
BoxData[
"\"\:2514\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\:2518\"",
StandardForm],"Print",ExpressionUUID -> "8605bea1-efcc-42d7-8f6d-47118e60365b"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "f2d567fb-5a89-484f-85b9-f4662163941d"],Cell[
BoxData[
"\"Ansatz: x(t) = e^{A(t-t_{k-1})} c(t)\"",StandardForm],"Print",ExpressionUUID -> "4c726030-0472-4df0-ac09-6fe64ba2acf8"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "a447f0a5-c326-4d62-8723-c568045b3cfd"],Cell[
BoxData[
"\"where c(t) is an unknown vector function to be determined.\"",StandardForm],"Print",
ExpressionUUID -> "094cc5a9-591c-4499-a2cb-91cfb914e724"],Cell[
BoxData["\"\"",StandardForm],
"Print",ExpressionUUID -> "ea1fa243-90e4-4bd7-aee3-08110dd0b639"],Cell[
BoxData["\"Substituting into dx/dt = Ax + B(t):\"",
StandardForm],"Print",ExpressionUUID -> "bb443ba6-32d4-4d3d-b855-203a21285c19"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "2a1c9cb1-789d-4518-b023-4b42fdc59848"],Cell[
BoxData[
"\"    d/dt[e^{A(t-t_{k-1})} c(t)] = A\[CenterDot]e^{A(t-t_{k-1})}c(t) + B(t)\"",
StandardForm],"Print",ExpressionUUID -> "b1ab5fdd-9d5d-4f54-aa4b-dae95666a2a5"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "76d0e7c0-8037-48dc-a504-6f8c8a4d31d8"],Cell[
BoxData[
"\"Using product rule:\"",StandardForm],"Print",ExpressionUUID -> "5348ef3d-1630-4af3-a04b-5526b6ea7141"],Cell[
BoxData[
"\"    A\[CenterDot]e^{A(t-t_{k-1})}c(t) + e^{A(t-t_{k-1})}c'(t) = A\[CenterDot]e^{A(t-t_{k-1})}c(t) + B(t)\"",
StandardForm],"Print",ExpressionUUID -> "da508ea6-cf55-44b2-8d78-e41b409853ab"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "9cbee960-e961-43d2-baf5-84a499b19478"],Cell[
BoxData[
"\"Canceling the A\[CenterDot]e^{...}c(t) terms:\"",StandardForm],"Print",ExpressionUUID -> "6df9bad0-7c35-482e-8f8b-6e85650f4e20"],Cell[
BoxData[
"\"    e^{A(t-t_{k-1})} c'(t) = B(t)\"",StandardForm],"Print",ExpressionUUID -> "f3863df5-5226-40d0-b16d-9189869066b2"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "58244594-5245-4651-9901-56943f4e2a34"],Cell[
BoxData[
"\"Therefore:\"",StandardForm],"Print",ExpressionUUID -> "8a654d83-46e8-4791-8457-45d771c50015"],Cell[
BoxData[
"\"    c'(t) = e^{-A(t-t_{k-1})} B(t)\"",StandardForm],"Print",ExpressionUUID -> "feef9ed4-c819-458c-8234-830675b6785c"],Cell[
BoxData[
"\"\\n\:250c\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\:2510\"",
StandardForm],"Print",ExpressionUUID -> "bba4d808-271e-41f2-a2a4-ef9ce407dc17"],Cell[
BoxData[
"\"\[VerticalLine] STEP 3: Integration                                         \[VerticalLine]\"",
StandardForm],"Print",ExpressionUUID -> "17d3df93-31ae-44a0-8e0a-b19c614005ed"],Cell[
BoxData[
"\"\:2514\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\:2518\"",
StandardForm],"Print",ExpressionUUID -> "e492202d-db32-4f63-937a-dc91e979d137"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "57b27bfc-4bcc-4f53-9865-d7be54c3ac4f"],Cell[
BoxData[
"\"Integrating c'(t) from t_{k-1} to t_k:\"",StandardForm],"Print",ExpressionUUID -> "9f22f68b-0d06-437d-93be-21eb3ad9161b"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "0b295b8c-79d0-4945-9ba0-4370b09937e7"],Cell[
BoxData[
"\"    c(t_k) - c(t_{k-1}) = \[Integral]_{t_{k-1}}^{t_k} e^{-A(s-t_{k-1})} B(s) ds\"",
StandardForm],"Print",ExpressionUUID -> "7571a405-66b4-46ad-9f50-09ae40c1a243"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "b433c9a2-ee45-4eac-b29f-be4fb633be41"],Cell[
BoxData[
"\"Initial condition: c(t_{k-1}) = x_{k-1}  (from ansatz at t=t_{k-1})\"",StandardForm],
"Print",ExpressionUUID -> "2fc9aea4-d693-4298-bce5-3549cf24ed42"],Cell[
BoxData["\"\"",
StandardForm],"Print",ExpressionUUID -> "4c137ac0-0f35-4a36-829d-a35b23f6078b"],Cell[
BoxData[
"\"Therefore:\"",StandardForm],"Print",ExpressionUUID -> "ff029f4c-2f93-4239-96f4-38a4e56e8943"],Cell[
BoxData[
"\"    c(t_k) = x_{k-1} + \[Integral]_{t_{k-1}}^{t_k} e^{-A(s-t_{k-1})} B(s) ds\"",
StandardForm],"Print",ExpressionUUID -> "42351506-9be2-4968-84d3-124228a7a57b"],Cell[
BoxData[
"\"\\n\:250c\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\:2510\"",
StandardForm],"Print",ExpressionUUID -> "28d0a88e-9b0e-47ba-b412-9ad3b0c181e5"],Cell[
BoxData[
"\"\[VerticalLine] STEP 4: Final Solution (Variation of Constants)             \[VerticalLine]\"",
StandardForm],"Print",ExpressionUUID -> "71fb32da-6a1c-44dd-bbdf-fd13b49e34d9"],Cell[
BoxData[
"\"\:2514\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\:2518\"",
