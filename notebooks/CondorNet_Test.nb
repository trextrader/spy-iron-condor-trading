StandardForm],"Print",ExpressionUUID -> "22158d00-ebe3-423f-9e10-765aebcb6f16"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "b5160904-0ce5-4084-97c0-5b65524a0e9a"],Cell[
BoxData[
"\"Change of variables: \[Tau] = t_k - s, so s = t_k - \[Tau], ds = -d\[Tau]\"",StandardForm],
