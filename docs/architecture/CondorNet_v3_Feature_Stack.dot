digraph CondorNet_v4_Feature_Stack {
    rankdir=TB;
    splines=curved;
    bgcolor="#000000";
    fontname="Arial,Sans-Serif";
    fontsize=30;
    labelloc="t";
    label="CondorNet™ HAL-S3N v4.0 Feature Stack\n(87-Column Multi-Layer Architecture)";
    fontcolor="#ffffff";
    nodesep=0.5;
    ranksep=0.55;
    compound=true;
    newrank=true;

    // GLOBAL NODE STYLE
    node [
        fontname="Arial,Sans-Serif",
        fontsize=15,
        shape=box,
        style="filled,rounded",
        fillcolor="#1a1a1a",
        color="#555555",
        fontcolor="#ffffff",
        penwidth=2.5,
        margin="0.3,0.15"
    ];

    // GLOBAL EDGE STYLE
    edge [
        color="#555555",
        penwidth=1.8,
        arrowsize=1.0,
        fontname="Arial,Sans-Serif",
        fontsize=12,
        fontcolor="#bbbbbb"
    ];

    // =========================================================================
    // DATA SOURCES — 2×2 grid inside cluster
    // =========================================================================
    subgraph cluster_sources {
        label="DATA SOURCES  (synchronized @ 1-min resolution)";
        fontsize=18;
        fontcolor="#00d4ff";
        style="rounded,dashed";
        color="#00d4ff";
        penwidth=2;

        src_options [label="SPY Options Chain\n(Greeks, IV, Volume, OI, TE, IVR)", fillcolor="#0d1f2d", color="#00d4ff", width=3.5];
        src_ohlcv   [label="SPY OHLCV\n(Barchart M1 Bars)", fillcolor="#0d1f2d", color="#00d4ff", width=3.5];
        src_alpaca  [label="Alpaca Tick-Level Quotes\n(Bid/Ask, Microstructure)", fillcolor="#0d1f2d", color="#00d4ff", width=3.5];
        src_derived [label="Derived Studies\n(Trend, Volatility, Breadth, Flow)", fillcolor="#0d1f2d", color="#00d4ff", width=3.5];

        // Force 2×2 layout
        { rank=same; src_options; src_ohlcv; }
        { rank=same; src_alpaca; src_derived; }
    }

    // MERGE NODE
    merge [label="⬇  Unified Timestamp-Keyed Merge  (Left Join Across Full Chain)  ⬇", fillcolor="#1a2a3a", color="#00d4ff", fontsize=17, penwidth=3, width=8.0];

    src_options -> merge [color="#00d4ff"];
    src_ohlcv   -> merge [color="#00d4ff"];
    src_alpaca  -> merge [color="#00d4ff"];
    src_derived -> merge [color="#00d4ff"];

    // =========================================================================
    // FEATURE LAYERS — Stacked vertically in pairs
    // =========================================================================

    // --- ROW 1: PRICE + VOLATILITY ---
    subgraph cluster_price {
        label="PRICE LAYER";
        fontsize=16;
        fontcolor="#4a6cff";
        style="rounded";
        color="#4a6cff";
        penwidth=2;
        price_features [label="open  ·  high  ·  low  ·  close  ·  log_return\nSMA  ·  MACD  ·  RSI  ·  ADX  ·  PSAR", fillcolor="#0d1a3a", color="#4a6cff", fontsize=13, width=4.0];
    }

    subgraph cluster_vol {
        label="VOLATILITY LAYER";
        fontsize=16;
        fontcolor="#ed8936";
        style="rounded";
        color="#ed8936";
        penwidth=2;
        vol_features [label="vol_ewma  ·  atr_pct  ·  kappa_proxy  ·  vol_energy\nIV_High  ·  IV_Mid  ·  IV_Low  ·  IVR", fillcolor="#2a1a0a", color="#ed8936", fontsize=13, width=4.0];
    }

    { rank=same; price_features; vol_features; }

    // --- ROW 2: TREND + FLOW ---
    subgraph cluster_trend {
        label="TREND & STRUCTURE";
        fontsize=16;
        fontcolor="#48bb78";
        style="rounded";
        color="#48bb78";
        penwidth=2;
        trend_features [label="FRAMA (Fractal Trend)\nAnchored VWAP (Vol-Anchored Equilibrium)\nBollinger Bands (μ, σ, Percentile, BW)", fillcolor="#0d2a1a", color="#48bb78", fontsize=13, width=4.0];
    }

    subgraph cluster_flow {
        label="FLOW & BREADTH";
        fontsize=16;
        fontcolor="#e53e3e";
        style="rounded";
        color="#e53e3e";
        penwidth=2;
        flow_features [label="CMF  ·  AccDistWill  ·  AccDistWillMovAvg\nWeightedAlpha  ·  WilderAccSwingIndex\nMcClellanOsc  ·  OSC_Volume", fillcolor="#2a0d0d", color="#e53e3e", fontsize=13, width=4.0];
    }

    { rank=same; trend_features; flow_features; }

    // --- ROW 3: GREEKS + MICROSTRUCTURE ---
    subgraph cluster_greeks {
        label="OPTIONS SURFACE";
        fontsize=16;
        fontcolor="#d69e2e";
        style="rounded";
        color="#d69e2e";
        penwidth=2;
        greeks_features [label="delta  ·  gamma  ·  vega  ·  theta  ·  rho  ·  iv\nOpt_Total_Vol  ·  Opt_Put_Vol  ·  Opt_Call_Vol", fillcolor="#2a2a0d", color="#d69e2e", fontsize=13, width=4.0];
    }

    subgraph cluster_micro {
        label="MICROSTRUCTURE";
        fontsize=16;
        fontcolor="#00d4ff";
        style="rounded";
        color="#00d4ff";
        penwidth=2;
        micro_features [label="agg_bid_count  ·  agg_ask_count\nmean_bid  ·  mean_ask\nquote_spread  ·  friction_ratio", fillcolor="#0d1f2d", color="#00d4ff", fontsize=13, width=4.0];
    }

    { rank=same; greeks_features; micro_features; }

    // --- ROW 4: FUZZY (centered) ---
    subgraph cluster_fuzzy {
        label="FUZZY / CONTROL LAYER";
        fontsize=16;
        fontcolor="#9f7aea";
        style="rounded";
        color="#9f7aea";
        penwidth=2;
        fuzzy_features [label="chaos_membership  ·  fuzzy_reversion_11\nexec_allow  ·  gap_risk_score  ·  risk_override", fillcolor="#1a0d2a", color="#9f7aea", fontsize=13, width=5.0];
    }

    // MERGE → Feature Layers (vertical pairs)
    merge -> price_features  [color="#4a6cff"];
    merge -> vol_features    [color="#ed8936"];

    price_features  -> trend_features  [color="#4a6cff", style=dashed, penwidth=1.2];
    vol_features    -> flow_features   [color="#ed8936", style=dashed, penwidth=1.2];

    trend_features  -> greeks_features [color="#48bb78", style=dashed, penwidth=1.2];
    flow_features   -> micro_features  [color="#e53e3e", style=dashed, penwidth=1.2];

    greeks_features -> fuzzy_features  [color="#d69e2e", style=dashed, penwidth=1.2];
    micro_features  -> fuzzy_features  [color="#00d4ff", style=dashed, penwidth=1.2];

    // =========================================================================
    // NEURAL GATING
    // =========================================================================
    gating [label="Neural Gating  ·  Regime Classification\nReversal Detection  ·  Execution-Aware Decision Modules", fillcolor="#1a1a2a", color="#ffffff", fontsize=17, penwidth=3, width=8.0, fontcolor="#ffffff"];

    fuzzy_features -> gating [color="#9f7aea", penwidth=2.5];

    // =========================================================================
    // OUTPUT SIGNALS — 2×2 grid
    // =========================================================================
    subgraph cluster_outputs {
        label="OUTPUTS";
        fontsize=18;
        fontcolor="#ffffff";
        style="rounded,bold";
        color="#ffffff";
        penwidth=2;

        out_reversal [label="Reversal Scores\n(Trend + IV + Breadth + Flow)", fillcolor="#1a3a1a", color="#48bb78", fontsize=13, width=3.5];
        out_regime   [label="Regime Classification\n(Volatility, Liquidity, Breadth)", fillcolor="#2a1a3a", color="#9f7aea", fontsize=13, width=3.5];
        out_exec     [label="Execution-Aware Signals\n(Microstructure Adjusted)", fillcolor="#1a2a3a", color="#00d4ff", fontsize=13, width=3.5];
        out_risk     [label="Risk Metrics\n(Drawdown, Entropy, Fuzzy Loss)", fillcolor="#2a1a1a", color="#e53e3e", fontsize=13, width=3.5];

        { rank=same; out_reversal; out_regime; }
        { rank=same; out_exec; out_risk; }
    }

    gating -> out_reversal [color="#48bb78"];
    gating -> out_regime   [color="#9f7aea"];
    gating -> out_exec     [color="#00d4ff"];
    gating -> out_risk     [color="#e53e3e"];

    // Copyright
    subgraph cluster_copyright {
        style=invis;
        rank=sink;
        node [shape=plaintext, fontsize=13, fontcolor="#888888"];
        copyright_note [label="© 2026 QuantorMT-Fuzz™ HAL-S3N DataSet Pipeline"];
    }
}
